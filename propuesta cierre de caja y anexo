### B.5 Servicio de consulta (desacoplado)

```python
# services/tasas.py (nuevo archivo)
import requests
from decimal import Decimal
from django.utils import timezone
from datetime import timedelta

class ProveedorTasaBCV:
    """Consulta la tasa BCV con fallback entre múltiples fuentes."""
    
    FUENTES = [
        {
            'nombre': 'dolarapi.com',
            'url': 'https://ve.dolarapi.com/v1/dolares/oficial',
            'extraer': lambda r: Decimal(str(r['promedio'])),
        },
        {
            'nombre': 'pydolarve.org',
            'url': 'https://pydolarve.org/api/v1/dollar?page=bcv',
            'extraer': lambda r: Decimal(str(r['monitors']['bcv']['price'])),
        },
    ]
    
    @classmethod
    def consultar(cls, timeout=5):
        for fuente in cls.FUENTES:
            try:
                resp = requests.get(fuente['url'], timeout=timeout)
                resp.raise_for_status()
                tasa = fuente['extraer'](resp.json())
                if tasa > 0:
                    return {
                        'tasa': tasa,
                        'fuente': fuente['nombre'],
                        'obtenida_el': timezone.now(),
                    }
            except Exception as e:
                print(f"?? Fuente {fuente['nombre']} falló: {e}")
                continue
        return None  # todas fallaron
```

